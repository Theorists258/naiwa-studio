{
  "name": "naiwa-studio",
  "version": "0.1.0",
  "description": "奶蛙采样音乐工作台：可切换的步进音序器与打击垫，支持变调、录制和 WAV 导出。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/audio-engine.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Theorists258/naiwa-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Theorists258/naiwa-studio/issues"
  },
  "homepage": "https://github.com/Theorists258/naiwa-studio#readme"
}
